# Copy this to .env and customize; .env must NOT be committed.
# Development-only PostgreSQL password. Set a unique value.
DB_URL=jdbc:postgresql://localhost:5432/campusconnect
DB_USERNAME=campusconnect
DB_PASSWORD=change_this_local_database_password
# Optional: set to your college's actual approved email domain (without @).
# Leave blank for a localhost demo with test emails.
APP_ALLOWED_EMAIL_DOMAIN=
# ADMIN CREATED ON FIRST BACKEND STARTUP, and stored in PostgreSQL with BCrypt.
# Set these only on the first start. Remove the password from .env afterward.
APP_ADMIN_EMAIL=admin@example.edu
APP_ADMIN_NAME=CampusAdmin
APP_ADMIN_PASSWORD=replace_with_your_own_secure_password_123!
# Local HTTP only. Production must use HTTPS and SESSION_COOKIE_SECURE=true.
SESSION_COOKIE_SECURE=false
